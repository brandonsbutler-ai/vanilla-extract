# A "run" is a maximal stretch of identifier characters. Candidate names are
# cut out of a run at boundaries that are NOT alphanumeric, which reproduces
# the old `(?<![A-Za-z0-9])name(?![A-Za-z0-9])` exactly: `_` bounds a name, so
# a two-part table entry like `AAA_BBB` matches inside `xx_AAA_BBB_yy`, and a
# letter does not, so the CSS variable `--violet:#bc8cff` and the legend line
# `#   violet   nothing imports it` yield the token `violet` and nothing else
# -- they never produce the longer name that would match.
RUN_RE = re.compile(r"[A-Za-z0-9_]+")

# Round numbers, deliberately loose, chosen to bound the work rather than to
# describe the table: they say only "nothing shorter than 4 or longer than 32",
# which is true of any plausible product name and tells an attacker nothing he
# could not have assumed. Do not tighten these to the table's real extremes --
# that would hand over the exact lengths for free.
MIN_TOKEN_LEN = 4
MAX_TOKEN_LEN = 32


def name_digest(s: str) -> str:
    """The one definition of how a name is hashed. Lowercased, UTF-8, hex."""
    return hashlib.sha256(s.lower().encode("utf-8")).hexdigest()


def _segments(run, prefix_mode):
    """Yield (start, end) slices of `run` that sit on non-alphanumeric edges.

    starts: the run's start, and every position just after a `_`.
    ends:   for a whole name, the run's end and every position of a `_`.
            for a prefix, every position just after a `_` -- a prefix has no
            trailing boundary (in the old regex `PREFIX_` matched inside
            `PREFIX_ANYTHING`), and every prefix in the table ends in `_`, so
            the underscores are the only ends worth trying.
    """
    cuts = [i for i, ch in enumerate(run) if ch == "_"]
    starts = [0]
    starts.extend(i + 1 for i in cuts)
    if prefix_mode:
        ends = [i + 1 for i in cuts]
    else:
        ends = cuts + [len(run)]
    for s in starts:
        for e in ends:                       # ends is ascending
            d = e - s
            if d < MIN_TOKEN_LEN:
                continue
            if d > MAX_TOKEN_LEN:
                break
            yield s, e


def _token_finder(digests, prefix_mode=False):
    """-> find(text) yielding (offset, matched_text) for hashed hits.

    The fast path matters: the overwhelming majority of identifier runs have no
    underscore, so they are one candidate and one hash. Only runs containing
    `_` pay for the segment walk.
    """
    def find(text):
        for m in RUN_RE.finditer(text):
            run = m.group(0)
            base = m.start()
            if "_" not in run:
                if prefix_mode:
                    continue                 # a prefix in the table ends in _
                if MIN_TOKEN_LEN <= len(run) <= MAX_TOKEN_LEN:
                    if name_digest(run) in digests:
                        yield base, run
                continue
            for s, e in _segments(run, prefix_mode):
                cand = run[s:e]
                if name_digest(cand) in digests:
                    yield base + s, cand
    return find

