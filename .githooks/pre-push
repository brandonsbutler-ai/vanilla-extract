#!/usr/bin/env python3
"""pre-push guard: refuse to publish machine identity, credentials, internal
product names, or CodeCobbler's own survey output to a public remote.

Python 3 stdlib only. No third-party anything, to match the repo it guards.

WHY IT SCANS HISTORY AND NOT THE WORKING TREE
---------------------------------------------
2026-09-17 a history rewrite scrubbed /media/republicon/... from this repo and
MISSED `W:\\LinuxSideClaudeProjects\\CP\\resume\\cobblerpy` in
packaging/CodeCobbler.bat. That string is still reachable from 39 commits and
from tags v0.1.0 and v0.1.1. The working tree has been clean since 2026-09-19.

So a gate that looks at `git diff`, at the index, or at the checkout would have
reported ALL CLEAR every single time while the leak sat in published history.
This gate reads the refs git hands a pre-push hook on stdin and scans the blobs
those refs actually carry to the remote, plus the tip tree, plus commit and tag
messages.

CONTRACT (githooks(5), verified against git's own pre-push.sample)
------------------------------------------------------------------
  argv[1] = remote name, argv[2] = remote URL (equal when pushing a bare URL)
  stdin   = one line per ref:  <local ref> SP <local oid> SP <remote ref> SP <remote oid> LF
  local ref is the literal "(delete)" and local oid is all-zeroes for a deletion
  remote oid is all-zeroes when the remote ref does not exist yet
  non-zero exit aborts the whole push, nothing is sent
"""

from __future__ import annotations

import fnmatch
import hashlib
import os
import re
import subprocess
import sys
import time

# --------------------------------------------------------------------------
# rule table
# --------------------------------------------------------------------------
#
# Every pattern below is written to be narrow on purpose. A gate that cries
# wolf gets `--no-verify`'d into irrelevance, and then it protects nothing.
# Where a pattern cannot be made narrow enough to justify blocking, it warns.

BLOCK = "BLOCK"
WARN = "WARN"

# Names that are generic enough to be documentation rather than a real machine.
# `/home/runner/` is GitHub Actions. `/Users/you/` is a manual. Those warn.
# Anything else is somebody's actual account name and blocks.
GENERIC_USERS = {
    "user", "users", "username", "youruser", "yourname", "you", "me", "name",
    "someone", "somebody", "example", "ubuntu", "debian", "root", "runner",
    "vagrant", "docker", "node", "ci", "build", "builder", "test", "tester",
    "linuxbrew", "admin", "developer", "dev", "foo", "bar", "USER",
}

# Values that are obviously a stand-in rather than a secret.
PLACEHOLDER_RE = re.compile(
    r"^(?:"
    r"|x{3,}|\*{3,}|\.{3,}|-{3,}|_{3,}"
    r"|<[^>]*>|\{\{?[^}]*\}?\}|\$\{?[A-Za-z_][A-Za-z0-9_]*\}?|%[sdr]|%\([^)]*\)s"
    r"|None|null|nil|true|false|TODO|FIXME|CHANGEME|changeme|REDACTED|redacted"
    r"|your[-_ ]?[a-z_]*|my[-_ ]?[a-z_]*|some[-_ ]?[a-z_]*"
    r"|password|passwd|secret|api[-_]?key|token|hunter|letmein|s3cret"
    r"|placeholder|dummy|fake|sample|example[a-z0-9_-]*|test[a-z0-9_-]*"
    r"|os\.environ.*|getenv.*|process\.env.*"
    r")$",
    re.IGNORECASE,
)

RESERVED_EMAIL_DOMAINS = (
    "example.com", "example.org", "example.net", "example.edu",
    "invalid", "localhost", "test", "local",
)


def _user_severity(match: re.Match) -> str:
    """Block a real account name; warn on a documentation placeholder."""
    who = (match.group("user") or "").strip("\"'")
    # A shell expansion is a variable, not a person: install-launcher.sh does
    # `for c in /media/"${USER:-}"/*` and that is correct, portable code.
    if "$" in who or "%" in who or "*" in who or "~" in who:
        return WARN
    # `/media/.../CP/resume` in a docstring is a redaction, not an account.
    if set(who) <= {".", "_", "-"} or "..." in who:
        return WARN
    if who in GENERIC_USERS or who.lower() in GENERIC_USERS:
        return WARN
    return BLOCK


def _secret_value_severity(match: re.Match) -> str | None:
    """Decide whether `password = "..."` is a secret, a stand-in, or noise."""
    val = match.group("val")
    if len(val) < 6:
        return None
    if PLACEHOLDER_RE.match(val):
        return None
    if val.startswith(("$", "{", "<", "%")) or val.endswith("}"):
        return None
    has_alpha = any(c.isalpha() for c in val)
    has_digit = any(c.isdigit() for c in val)
    has_other = any(not c.isalnum() for c in val)
    # Real secrets are mixed-class. A lone English word assigned to `password`
    # is far more often a fixture or a prompt string than a live credential,
    # so it warns instead of blocking.
    if has_alpha and (has_digit or has_other):
        return BLOCK
    return WARN


def _email_severity(match: re.Match) -> str | None:
    domain = match.group("domain").lower()
    if domain in RESERVED_EMAIL_DOMAINS or domain.endswith(
        tuple("." + d for d in RESERVED_EMAIL_DOMAINS)
    ):
        return None
    if match.group(0).lower().startswith(("noreply@", "no-reply@")):
        return None
    return WARN


class Rule:
    __slots__ = ("rid", "category", "severity", "regex", "why", "redact", "refine")

    def __init__(self, rid, category, severity, pattern, why,
                 flags=0, redact=False, refine=None):
        self.rid = rid
        self.category = category
        self.severity = severity
        self.regex = re.compile(pattern, flags)
        self.why = why
        self.redact = redact
        self.refine = refine


