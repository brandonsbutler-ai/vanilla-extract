# --------------------------------------------------------------------------
# rule table
# --------------------------------------------------------------------------
#
# Every pattern below is written to be narrow on purpose. A gate that cries
# wolf gets `--no-verify`'d into irrelevance, and then it protects nothing.
# Where a pattern cannot be made narrow enough to justify blocking, it warns.

BLOCK = "BLOCK"
WARN = "WARN"

# `redact` modes. MASK keeps the ends of a credential so it can be recognised
# without being readable. HIDE prints nothing of the match at all, and is what
# every hashed rule uses: the whole point of hashing the table was to stop the
# name being published, and printing it on the way to refusing it -- into a
# terminal, a CI job log, a pasted bug report -- republishes it just as well.
MASK = "mask"
HIDE = "hide"

# --------------------------------------------------------------------------
# hashed name tables
# --------------------------------------------------------------------------
#
# SHA-256 of each name, LOWERCASED, hex, sorted. Sorted on purpose: the order
# then carries no information about which name is which, and a diff that adds
# one does not show where it landed in somebody's mental list.
#
# Regenerate or extend with:  python3 .githooks/pre-push --hash NAME [NAME...]
#
# THREAT MODEL, honestly: these are short words. Anyone who suspects a name can
# hash it and get a yes/no in microseconds, and a large wordlist will recover
# the ordinary-English ones. That is unavoidable for any scheme that has to
# recognise the name using only what is committed here -- a salt committed
# beside the hashes is not a salt, and a salt kept outside the repo makes the
# rule silently do nothing on a fresh clone, which is fail-open and worse than
# the leak. Key-stretching (PBKDF2/scrypt) is also out: the guard hashes every
# candidate token in every blob, millions per push, so any per-hash cost that
# hurts an attacker stops the guard dead. Plain SHA-256 is the honest choice.
# It converts DISCLOSURE ("here is the list") into a CONFIRMATION ORACLE ("is
# it this one?"), which is the harm that was actually being done.

