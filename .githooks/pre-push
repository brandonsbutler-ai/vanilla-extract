# PREFIXES. Every entry here MUST end in `_`; the matcher only ever offers it
# candidates that end in `_`, because that is how it finds prefix boundaries
# without being told how long a prefix is. A prefix that did not end in `_`
# would be stored and never matched -- silently. `--hash --prefix` refuses one.
INTERNAL_PREFIX_SHA256 = frozenset((
    "41a6bbf5f4f8a4b0377126f266d796e85e784d575bab1120282d2fbcd66c9baf",
    "a9004a57c1f4e25d3d2ba24b77405930c78d5f6961d8bef859aaa348b527d9b1",
))

