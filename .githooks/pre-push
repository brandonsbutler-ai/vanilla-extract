# Values that are obviously a stand-in rather than a secret.
PLACEHOLDER_RE = re.compile(
    r"^(?:"
    r"|x{3,}|\*{3,}|\.{3,}|-{3,}|_{3,}"
    r"|<[^>]*>|\{\{?[^}]*\}?\}|\$\{?[A-Za-z_][A-Za-z0-9_]*\}?|%[sdr]|%\([^)]*\)s"
    r"|None|null|nil|true|false|TODO|FIXME|CHANGEME|changeme|REDACTED|redacted"
    r"|your[-_ ]?[a-z_]*|my[-_ ]?[a-z_]*|some[-_ ]?[a-z_]*"
    r"|password|passwd|secret|api[-_]?key|token|hunter|letmein|s3cret"
    r"|placeholder|dummy|fake|sample|example[a-z0-9_-]*|test[a-z0-9_-]*"
    r"|os\.environ.*|getenv.*|process\.env.*"
    r")$",
    re.IGNORECASE,
)

RESERVED_EMAIL_DOMAINS = (
    "example.com", "example.org", "example.net", "example.edu",
    "invalid", "localhost", "test", "local",
)


def _user_severity(match: re.Match) -> str:
    """Block a real account name; warn on a documentation placeholder."""
    who = (match.group("user") or "").strip("\"'")
    # A shell expansion is a variable, not a person: install-launcher.sh does
    # `for c in /media/"${USER:-}"/*` and that is correct, portable code.
    if "$" in who or "%" in who or "*" in who or "~" in who:
        return WARN
    # `/media/.../CP/resume` in a docstring is a redaction, not an account.
    if set(who) <= {".", "_", "-"} or "..." in who:
        return WARN
    if who in GENERIC_USERS or who.lower() in GENERIC_USERS:
        return WARN
    return BLOCK


def _secret_value_severity(match: re.Match) -> str | None:
    """Decide whether `password = "..."` is a secret, a stand-in, or noise."""
    val = match.group("val")
    if len(val) < 6:
        return None
    if PLACEHOLDER_RE.match(val):
        return None
    if val.startswith(("$", "{", "<", "%")) or val.endswith("}"):
        return None
    has_alpha = any(c.isalpha() for c in val)
    has_digit = any(c.isdigit() for c in val)
    has_other = any(not c.isalnum() for c in val)
    # Real secrets are mixed-class. A lone English word assigned to `password`
    # is far more often a fixture or a prompt string than a live credential,
    # so it warns instead of blocking.
    if has_alpha and (has_digit or has_other):
        return BLOCK
    return WARN


def _email_severity(match: re.Match) -> str | None:
    domain = match.group("domain").lower()
    if domain in RESERVED_EMAIL_DOMAINS or domain.endswith(
        tuple("." + d for d in RESERVED_EMAIL_DOMAINS)
    ):
        return None
    if match.group(0).lower().startswith(("noreply@", "no-reply@")):
        return None
    return WARN


class Rule:
    __slots__ = ("rid", "category", "severity", "regex", "finder", "why",
                 "redact", "refine")

    def __init__(self, rid, category, severity, pattern, why,
                 flags=0, redact=False, refine=None, finder=None):
        self.rid = rid
        self.category = category
        self.severity = severity
        self.regex = re.compile(pattern, flags) if pattern is not None else None
        self.finder = finder
        self.why = why
        self.redact = redact
        self.refine = refine
        if (self.regex is None) == (finder is None):
            raise ValueError("rule %s needs exactly one of pattern/finder" % rid)

    def find(self, text):
        """-> (offset, matched_text, match_or_None).

        A hashed rule has no match object, so it cannot have a `refine` step --
        refine exists to look at capture groups, and there are none.
        """
        if self.regex is not None:
            for m in self.regex.finditer(text):
                yield m.start(), m.group(0), m
        else:
            for start, tok in self.finder(text):
                yield start, tok, None


